DISCORD_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=123456789012345678

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required by the webhook service; it refuses to start without it
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# Optional: enables the PR file checks (`any` guard, T3 path guard)
GITHUB_TOKEN=

# IANA timezone for scheduled jobs and day boundaries, e.g. Asia/Manila
TIMEZONE=UTC

# Discord role names allowed to run Lead/Professor commands
DISCORD_ROLE_LEAD=Lead
DISCORD_ROLE_PROFESSOR=Professor

# Optional: AI-written /journal summary
COMPANION_AI_ENABLED=false
ANTHROPIC_API_KEY=

CHANNEL_TASK_FEED=111111111111111111
CHANNEL_STANDUP_LOG=222222222222222222
CHANNEL_GITHUB_FEED=333333333333333333
CHANNEL_CODE_REVIEW=444444444444444444
CHANNEL_PHASE_TRACKER=555555555555555555
CHANNEL_HELP=666666666666666666
CHANNEL_SHOUTOUTS=777777777777777777
CHANNEL_ANNOUNCEMENTS=888888888888888888
CHANNEL_TIP_OF_THE_DAY=999999999999999999
CHANNEL_RESOURCES=101010101010101010
CHANNEL_RETRO=111111111111111112
CHANNEL_RANKINGS=121212121212121212
CHANNEL_GENERAL=131313131313131313

DEBUG=false
